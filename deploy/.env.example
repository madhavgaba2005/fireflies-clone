# Copy to deploy/.env on the server. Never commit the real file.

# Your domain (e.g. notes.example.com → automatic HTTPS) or ":80" for plain HTTP on the server IP.
SITE_ADDRESS=:80
# Public origin of the app, used for CORS (same origin when served through Caddy).
PUBLIC_URL=http://localhost
# Host ports (change only to test locally next to other services).
HTTP_PORT=80
HTTPS_PORT=443
