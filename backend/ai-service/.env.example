# Copy to .env for local development. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# kafka (default, reference) | http (serves POST /internal/process for the fallback mode)
PROCESSING_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=meeting.events
KAFKA_RESULT_TOPIC=ai.events
KAFKA_CONSUMER_GROUP=ai-service

# Only used when PROCESSING_MODE=http. Must match the Meeting Service.
INTERNAL_API_TOKEN=

# Only "mock" ships (deterministic, no API key). See docs/adr/007-mock-summary-provider.md.
SUMMARY_PROVIDER=mock
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=1.0
