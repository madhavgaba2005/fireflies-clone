# Copy to .env for local development. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite file (directory is created automatically). In Docker: sqlite:////data/meetings.db
DATABASE_URL=sqlite:///./data/meetings.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# kafka (default, reference) | http (fallback for hosts without a broker) | inline-test (tests only)
PROCESSING_MODE=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=meeting.events
KAFKA_RESULT_TOPIC=ai.events

# Only used when PROCESSING_MODE=http. Use a long random value; must match the AI service.
AI_SERVICE_URL=http://localhost:8001
INTERNAL_API_TOKEN=
