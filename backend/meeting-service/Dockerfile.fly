FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app

# Fly.io variant: volumes mount root-owned, so start as root, hand /data to appuser, then drop
# privileges for the server (runuser is part of util-linux, always present on Debian).
RUN useradd --create-home appuser && mkdir -p /data

EXPOSE 8000
CMD ["sh", "-c", "chown appuser /data && exec runuser -u appuser -- uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8000"]
