# Normalize line endings: LF in the repository and in working trees on every OS,
# so formatters (ruff, prettier) and CI see identical files on Windows and Linux.
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.ico  binary
*.mp3  binary
*.mp4  binary
*.woff2 binary
*.db   binary
